# Copy to .env.local for dev; production uses systemd EnvironmentFile on pei.
FARO_PROFILE_DEFAULT=lwiki
# Production base URL (pei via Tailscale Serve, port-based — NOT sub-path):
FARO_BASE_URL=https://pei.taild21074.ts.net:8443
FARO_OWNER_LOGIN=lucaramirezol@gmail.com
# REQUIRED — set per host. NO safe default (diverges between laptop and pei).
#   laptop: /home/luca/projects/lwiki
#   pei:    /home/luca/lwiki
# Overrides profiles/lwiki.yml#agent_root.
FARO_AGENT_ROOT=/home/luca/projects/lwiki
# Optional: derived as ${FARO_AGENT_ROOT}/slack_agent/runs/state.db when absent.
# FARO_STATE_DB=
# Optional: Claude Code jsonl session telemetry root. Default differs per host:
#   laptop: /home/luca/.claude/projects/-home-luca-projects-lwiki
#   pei:    /home/luca/.claude/projects/-home-luca-lwiki
# When absent, derived from FARO_AGENT_ROOT via path-to-slug rule.
# FARO_JSONL_ROOT=
FARO_CCUSAGE_PATH=ccusage
FARO_OPENROUTER_API_KEY=
FARO_PRICING_REFRESH_HOURS=168
