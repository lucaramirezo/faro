# Copy to .env.local for dev; production uses systemd EnvironmentFile.
FARO_PROFILE_DEFAULT=lwiki
FARO_BASE_URL=https://faro.pei.<tailnet-id>.ts.net
FARO_OWNER_LOGIN=lucaramirezol@gmail.com
# Per-host: laptop = /home/luca/projects/lwiki, pei = /home/luca/lwiki.
# Overrides profiles/lwiki.yml#agent_root. Required (no safe default — diverges per host).
FARO_AGENT_ROOT=/home/luca/projects/lwiki
# Optional: derived as ${FARO_AGENT_ROOT}/slack_agent/runs/state.db when absent.
# FARO_STATE_DB=
FARO_CCUSAGE_PATH=ccusage
FARO_OPENROUTER_API_KEY=
FARO_PRICING_REFRESH_HOURS=168
