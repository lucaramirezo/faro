{
  "name": "faro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "postbuild": "rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && mkdir -p .next/standalone/.next/cache .next/standalone/data && if [ -d public ]; then cp -R public .next/standalone/public; fi",
    "start": "node .next/standalone/server.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@react-sigma/core": "^4.0.3",
    "@tremor/react": "^3.18.7",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "~4.9.0",
    "dompurify": "^3.4.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "graphology": "^0.25.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "gray-matter": "~4.0.3",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "shiki": "^4",
    "sigma": "^3.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "~6.5.0",
    "@testing-library/react": "~16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "~4.3.0",
    "happy-dom": "~15.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "~2.1.0"
  },
  "packageManager": "bun@1.3.13",
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "sharp",
    "unrs-resolver"
  ]
}
